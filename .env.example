# ============================================================================
# RAG Pipeline Configuration
# ============================================================================
# Copy this file to .env and configure your endpoints

# ============================================================================
# Embedding Configuration (for document/query vectorization)
# ============================================================================
# HuggingFace API token (optional for public models, required for gated models)
HF_API_TOKEN=your_huggingface_token_here

# Embedding endpoint URL (auto-detects OpenAI vs HuggingFace format)
# Examples:
# - Local LM Studio: http://192.168.1.100:3000/v1/embeddings
# - HuggingFace Inference: https://api-inference.huggingface.co/models/BAAI/bge-m3
# - HuggingFace Inference Endpoint: https://xxx.endpoints.huggingface.cloud
# - Text Embeddings Inference: http://localhost:8080
HF_ENDPOINT_URL=https://api-inference.huggingface.co/models/BAAI/bge-m3

# Embedding model ID
# Popular choices:
# - BAAI/bge-m3 (multilingual, 1024-dim, high quality)
# - intfloat/e5-large-v2 (English, 1024-dim)
# - sentence-transformers/all-MiniLM-L6-v2 (fast, 384-dim)
# - thenlper/gte-base-en-v1.5 (balanced, 768-dim)
EMBED_MODEL_ID=BAAI/bge-m3

# EOS (End of Sequence) token to append to text before embedding (optional)
# Use this if you see warnings about missing EOS/SEP tokens from GGUF models
# Common tokens by model family:
# - LLaMA/Mistral models: </s>
# - BERT models: SEP or [SEP]
# - GPT models: <|endoftext|>
# - Leave empty/commented for cloud APIs (they handle this automatically)
# EMBED_ADD_EOS_TOKEN=</s>

# ============================================================================
# LLM Configuration (for answer generation)
# ============================================================================
# LLM endpoint URL (auto-detects OpenAI vs HuggingFace format)
# Examples:
# - OpenAI (default): https://api.openai.com/v1
# - HuggingFace Inference: https://api-inference.huggingface.co/models/meta-llama/Llama-3.1-8B-Instruct
# - HuggingFace Inference Endpoint: https://xxx.endpoints.huggingface.cloud
# - LocalAI: http://localhost:8000/v1
# - vLLM: http://localhost:8000/v1
# - Ollama: http://localhost:11434/v1
# Leave empty to use OpenAI
LLM_ENDPOINT_URL=

# API token for LLM endpoint
# - For HuggingFace: Your HF token (can be same as HF_API_TOKEN)
# - For OpenAI: Your OpenAI API key (sk-...)
# - For local endpoints: May not be required, use "dummy" if needed
LLM_API_TOKEN=your_api_token_here

# LLM model ID
# OpenAI models:
# - gpt-4o (recommended)
# - gpt-4-turbo
# - gpt-3.5-turbo
# HuggingFace models:
# - meta-llama/Llama-3.1-8B-Instruct
# - meta-llama/Llama-3.1-70B-Instruct
# - mistralai/Mistral-7B-Instruct-v0.2
# - mistralai/Mixtral-8x7B-Instruct-v0.1
LLM_MODEL_ID=gpt-4o

# ============================================================================
# Database Configuration
# ============================================================================
# Path to SQLite database file
DB_PATH=.rag/rag.sqlite

# Path to sqlite-vec extension (auto-detected if using pip package)
# SQLITE_VEC_PATH=/path/to/vec0.so

# ============================================================================
# Chunking Configuration
# ============================================================================
# Target number of tokens per chunk
CHUNK_TARGET_TOKENS=512

# Number of overlapping tokens between chunks
CHUNK_OVERLAP_TOKENS=50

# ============================================================================
# Retrieval Configuration
# ============================================================================
# Number of chunks to retrieve for each query
RETRIEVAL_K=8

# Vector distance metric (cosine, l2, inner_product)
VECTOR_DISTANCE=cosine

# ============================================================================
# Performance Configuration
# ============================================================================
# Request timeout in seconds (increase if embedding large documents or slow models)
# Default: 30 seconds
# For local LM Studio on slower hardware: 60-120 seconds
# For cloud APIs (OpenAI, HuggingFace): 30 seconds is usually fine
REQUEST_TIMEOUT_SECONDS=30.0

# Maximum concurrent API requests
# For local models: 1-5 (avoid overloading)
# For cloud APIs: 10-20 (higher concurrency)
MAX_CONCURRENT_REQUESTS=10

# Embedding batch size
EMBEDDING_BATCH_SIZE=64

# ============================================================================
# Example Configurations
# ============================================================================

# Example 1: Local embeddings + HuggingFace LLM
# HF_ENDPOINT_URL=http://192.168.1.100:3000/v1/embeddings
# EMBED_MODEL_ID=text-embedding-granite-embedding-278m-multilingual
# LLM_ENDPOINT_URL=https://api-inference.huggingface.co/models/meta-llama/Llama-3.1-8B-Instruct
# LLM_API_TOKEN=your_hf_token
# LLM_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# Example 2: All HuggingFace (cloud)
# HF_API_TOKEN=your_hf_token
# HF_ENDPOINT_URL=https://api-inference.huggingface.co/models/BAAI/bge-m3
# EMBED_MODEL_ID=BAAI/bge-m3
# LLM_ENDPOINT_URL=https://api-inference.huggingface.co/models/meta-llama/Llama-3.1-70B-Instruct
# LLM_API_TOKEN=your_hf_token
# LLM_MODEL_ID=meta-llama/Llama-3.1-70B-Instruct

# Example 3: OpenAI only
# OPENAI_API_KEY=sk-your-openai-key
# # Embeddings will use OpenAI text-embedding-3-small
# # LLM will use gpt-4o

# Example 4: All local (LM Studio + Ollama)
# HF_ENDPOINT_URL=http://localhost:1234/v1/embeddings
# EMBED_MODEL_ID=nomic-ai/nomic-embed-text-v1.5
# LLM_ENDPOINT_URL=http://localhost:11434/v1
# LLM_API_TOKEN=dummy
# LLM_MODEL_ID=llama3.1:8b
